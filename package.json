{
  "name": "pitwall",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/diffs": "^1.6.4",
    "hono": "^4.13.17",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "shiki": "4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware server web/src scripts",
    "service:install": "node scripts/service.ts install",
    "service:uninstall": "node scripts/service.ts uninstall",
    "service:restart": "node scripts/service.ts restart",
    "open": "open -na 'Brave Browser Beta' --args --user-data-dir=\"$HOME/Library/Application Support/pitwall/brave\" --app=http://127.0.0.1:7420",
    "check": "tsc && pnpm lint && pnpm test",
    "claude:connect": "node scripts/claude.ts connect",
    "claude:disconnect": "node scripts/claude.ts disconnect",
    "test": "node scripts/isolate.ts node --test 'server/**/*.test.ts' 'web/src/**/*.test.ts'",
    "mock": "node scripts/mock/server.ts",
    "e2e": "node scripts/check/run.ts",
    "ux": "node scripts/ux.ts"
  }
}
